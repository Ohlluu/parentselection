# Copy to .env and fill in. Never commit the real .env.

# Signs the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
NODE_ENV=development

# Postgres connection string from your Neon dashboard. Leave this BLANK for
# local development and the app uses PGlite instead - real Postgres compiled
# to WASM, stored in ./.pgdata - so local testing runs the same SQL as
# production without needing a database server installed.
DATABASE_URL=

# Requests per IP per 15 minutes on the sign-in endpoints. Several parents can
# share one IP on a center's wifi, so don't set this too tight. Guessing a
# specific person's code is capped separately at 10 wrong attempts.
RATE_LIMIT_LOGIN=60
